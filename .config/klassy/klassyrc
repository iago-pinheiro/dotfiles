[Global]
LookAndFeelSet=org.kde.breezedark.desktop

[TitleBarOpacity]
ApplyOpacityToHeader=false
OpaqueMaximizedTitleBars=false
TitleBarOpacityActive=90
TitleBarOpacityInactive=90

[TitleBarSpacing]
TitleBarLeftMargin=5
TitleBarRightMargin=5

[Windeco]
AnimationsEnabled=false
ButtonIconStyle=StyleOxygen
ButtonShape=ShapeSmallCircle
IconSize=IconMedium
MatchTitleBarToApplicationColor=true
WindowCornerRadius=10

[WindowOutlineStyle]
WindowOutlineAccentWithContrastOpacityActive=100
WindowOutlineShadowColorOpacity=52
WindowOutlineStyleActive=WindowOutlineAccentWithContrast
WindowOutlineStyleInactive=WindowOutlineShadowColor
WindowOutlineThickness=4
